# Credenciales - NUNCA subir
token.json
client_secret.json
pexels_api_key.txt
azure_speech_key.json
.env

# Archivos multimedia generados (pesados, regenerables, no aptos para git)
*.mp4
*.mp3
*.wav
*.jpg
*.jpeg
*.png
*.srt
*.ass
audio/
imagenes/
videos/
subtitulos/
_tmp_v2/

# Excepcion: cola_audio/ SI viaja por git a proposito (puente local->nube,
# ver scripts/generar_audio_pipeline.py). Son ficheros temporales que la
# nube borra tras consumirlos, pero mientras estan en cola deben subirse.
!cola_audio/
!cola_audio/*.mp3
!cola_audio/*.json

# Excepcion: cola_imagenes/ SI viaja por git (mismo puente local->nube,
# 2026-09-21 — Wikimedia/NASA/Pollinations tambien estan bloqueados por la
# whitelist del sandbox cloud, igual que le pasaba al TTS). La nube las
# borra tras consumirlas.
!cola_imagenes/
!cola_imagenes/**/*.jpg

# Excepcion: cola_subtitulos/ SI viaja por git (mismo puente local->nube,
# 2026-09-21 tarde — el modelo de faster-whisper tambien esta bloqueado
# por la whitelist del sandbox cloud al intentar descargarlo desde
# Hugging Face Hub). La nube los borra tras consumirlos.
# El .ass (2026-09-22) son los subtitulos palabra-por-palabra "profesionales";
# el .srt de frase completa se conserva como respaldo si el .ass no llega.
!cola_subtitulos/
!cola_subtitulos/*.srt
!cola_subtitulos/*.ass

# Excepcion: musica/ SI viaja por git -- son 5 pistas FIJAS de fondo
# (Kevin MacLeod / incompetech.com, CC BY 4.0, ver musica/CREDITOS.txt),
# no colas temporales: viven en el repo permanentemente porque el mezclado
# ocurre dentro de producir_video.py, que SI corre en la nube (a diferencia
# de TTS/imagenes/subtitulos/miniatura, no dependen de red en tiempo de
# ejecucion, solo del propio fichero ya en el repo).
!musica/
!musica/*.mp3

# Excepcion: cola_miniaturas/ SI viaja por git (mismo puente local->nube,
# 2026-09-22 — la miniatura IA cinematografica usa Pollinations, tambien
# bloqueado por la whitelist del sandbox cloud). La nube la borra tras
# consumirla; si no llega, producir_video.py cae al metodo antiguo
# (fotograma del video + texto).
!cola_miniaturas/
!cola_miniaturas/*.jpg

# Python
__pycache__/
*.pyc
.venv/

# Clips reales de Commons que sustituyen a una foto (poner_clip.py)
!cola_imagenes/**/*.mp4
token_en.json
